    end

    local function onRemoteAdded(instance)
        if isRemote(instance) then
            if monitoring then attachRemote(instance) end
            task.defer(collectInventory)
        end
    end
    ReplicatedStorage.DescendantAdded:Connect(onRemoteAdded)
    ReplicatedStorage.DescendantRemoving:Connect(function(instance)
        local connection = remoteEventConnections[instance]
        if connection then
            connection:Disconnect()
            remoteEventConnections[instance] = nil
        end
        if isRemote(instance) then task.defer(collectInventory) end
    end)

