local function switchTab(name)
	currentTab = name

	for tabName, page in pairs(pages) do
		page.Visible = tabName == name
	end

	for tabName, tab in pairs(tabButtons) do
		local entryRole = tabName == name and "selectedTab" or "tab"
		tab.BackgroundColor3 =
			tabName == name and C.Purple or C.Item

		for _, entry in ipairs(themeButtons) do
			if entry.object == tab then
				entry.role = entryRole
				break
			end
		end
	end
end

