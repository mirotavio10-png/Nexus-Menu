local function mouseOverMenu()
    if not main.Visible then return false end
    local point = UserInputService:GetMouseLocation()
    local pos = main.AbsolutePosition
    local size = main.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X
        and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function runKeybindAction(actionName)
    if actionName == "Menu Toggle" then
        menuOpen = not menuOpen
        main.Visible = menuOpen
    elseif actionName == "Fly" and flyToggle then
        flyToggle.setValue(not flyToggle.value)
    elseif actionName == "Noclip" and noclipToggle then
        noclipToggle.setValue(not noclipToggle.value)
    elseif actionName == "Infinite Jump" and infiniteJumpToggle then
        infiniteJumpToggle.setValue(not infiniteJumpToggle.value)
    elseif actionName == "Click Teleport" and teleportClickToggle then
        teleportClickToggle.setValue(not teleportClickToggle.value)
    elseif actionName == "Click Destroy" and destroyClickToggle then
        destroyClickToggle.setValue(not destroyClickToggle.value)
    elseif actionName == "Run Boost" and runToggle then
        runToggle.setValue(not runToggle.value)
    elseif actionName == "Spectate Selected" then
        spectateSelected()
    elseif actionName == "Next Player" and spectateNextPlayer then
        spectateNextPlayer()
    elseif actionName == "Teleport to Selected" then
        teleportToSelected()
    elseif actionName == "Toggle Chams" and chamsToggle then
        chamsToggle.setValue(not chamsToggle.value)
    elseif actionName == "Toggle Name Tags" and nameTagsToggle then
        nameTagsToggle.setValue(not nameTagsToggle.value)
    end
end

local function captureKeybind(input)
    local actionName = waitingForKeybind
    if not actionName then return false end

    if input.KeyCode == Enum.KeyCode.Escape then
        waitingForKeybind = nil
        if keybindStatusLabel then keybindStatusLabel.Text = "Keybind change cancelled." end
        return true
    end
    if input.KeyCode == Enum.KeyCode.Unknown then return true end

    for otherAction, assignedKey in pairs(keybinds) do
        if otherAction ~= actionName and assignedKey == input.KeyCode then
            if keybindStatusLabel then
                keybindStatusLabel.Text = input.KeyCode.Name .. " is already assigned to " .. otherAction .. ". Choose another key."
            end
            notify("Keybind conflict", input.KeyCode.Name .. " is already used by " .. otherAction .. ".")
            return true
        end
    end

    keybinds[actionName] = input.KeyCode
    waitingForKeybind = nil
    refreshKeybindLabels()
    if keybindStatusLabel then
        keybindStatusLabel.Text = actionName .. " set to " .. input.KeyCode.Name .. "."
    end
    notify("Keybind updated", actionName .. ": " .. input.KeyCode.Name)
    return true
end

local function playDestroyEffect(position)
    -- Cosmetic particle burst only; it does not apply blast damage or force.
    local anchor = Instance.new("Part")
    anchor.Name = "NEXU_DestroyEffect"
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(position)
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Transparency = 1
    anchor.Parent = workspace

    local attachment = Instance.new("Attachment")
    attachment.Name = "NEXU_ExplosionAttachment"
    attachment.Parent = anchor

    local particles = Instance.new("ParticleEmitter")
    particles.Name = "NEXU_ExplosionParticles"
    particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particles.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLORS.Purple),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 190, 95)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 245, 220)),
    })
    particles.LightEmission = 0.8
    particles.Lifetime = NumberRange.new(0.35, 0.7)
    particles.Speed = NumberRange.new(10, 22)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Rotation = NumberRange.new(0, 360)
    particles.RotSpeed = NumberRange.new(-180, 180)
    particles.Acceleration = Vector3.new(0, -18, 0)
    particles.Drag = 4
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.65),
        NumberSequenceKeypoint.new(0.35, 0.4),
        NumberSequenceKeypoint.new(1, 0),
    })
    particles.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(0.7, 0.15),
        NumberSequenceKeypoint.new(1, 1),
    })
    particles.Enabled = false
    particles.Parent = attachment
    particles:Emit(32)

    Debris:AddItem(anchor, 1.5)
end

local function findLocalDestroyTarget(hit)
    if not hit or not hit:IsA("BasePart") or not hit:IsDescendantOf(workspace) then
        return nil, "Click a part in the 3D world."
    end

    local character = player.Character
    if character and hit:IsDescendantOf(character) then
        return nil, "Your character is protected."
    end

    local current = hit
    while current and current ~= workspace do
        if current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") then
                return nil, "Character and NPC models are protected."
            end
            return current
        end
        current = current.Parent
    end

    return hit
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if waitingForKeybind then
            captureKeybind(input)
            return
        end

        if not gameProcessed then
            for actionName, keyCode in pairs(keybinds) do
                if input.KeyCode == keyCode then
                    runKeybindAction(actionName)
                    return
                end
            end
        end
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if gameProcessed or mouseOverMenu() then return end

    if clickTeleportEnabled then
        local target = mouse.Target
        if not target then
            notify("Click-to-teleport", "Click a surface in the world.")
            return
        end

        local root = getRoot()
        local humanoid = getHumanoid()
        local hitPosition = mouse.Hit.Position
        if not root or not humanoid then
            notify("Click-to-teleport", "Your character is not ready.")
            return
        end
        if (hitPosition - root.Position).Magnitude > 250 then
            notify("Click-to-teleport", "That location is too far away (250 studs max).")
            return
        end

        local destination = hitPosition + Vector3.new(0, math.max(3, humanoid.HipHeight + 2), 0)
        root.CFrame = CFrame.new(destination, destination + root.CFrame.LookVector)
        root.AssemblyLinearVelocity = Vector3.zero
        notify("Click-to-teleport", "Moved locally. The server may correct this position.")

    elseif clickDestroyEnabled then
        local target = mouse.Target
        if not target then
            notify("Click-to-destroy", "Click a part in the world.")
            return
        end

        local destroyTarget, reason = findLocalDestroyTarget(target)
        if not destroyTarget then
            notify("Click-to-destroy", reason or "That object cannot be removed.")
            return
        end

        local targetName = destroyTarget.Name
        local destroyPosition
        if destroyTarget:IsA("Model") then
            destroyPosition = destroyTarget:GetPivot().Position
        else
            destroyPosition = destroyTarget.Position
        end

        playDestroyEffect(destroyPosition)
        destroyTarget:Destroy()
        notify("Click-to-destroy", "Removed " .. targetName .. " locally.")
    end
end)

-- Infinite jump: ordinary jump works on the ground; this adds another jump in air.
UserInputService.JumpRequest:Connect(function()
    if not infiniteJumpEnabled then return end
    local humanoid = getHumanoid()
    if humanoid and humanoid.Health > 0
        and humanoid.FloorMaterial == Enum.Material.Air then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

--========================================================
-- DRAG THE WINDOW FROM THE HEADER
--========================================================
local draggingWindow = false
local dragInput = nil
local dragStart = nil
local startPosition = nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = true
        dragStart = input.Position
        startPosition = main.Position
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingWindow and startPosition and dragStart then
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = false
        dragInput = nil
    end
end)

-- Keep the spectator list and local player visuals current as players join/leave.
local function hookOtherPlayer(target)
    target.CharacterAdded:Connect(function()
        task.wait(0.4)
        if refreshPlayerList then refreshPlayerList() end
        refreshPlayerVisuals()
    end)
end

for _, target in ipairs(Players:GetPlayers()) do
    if target ~= player then hookOtherPlayer(target) end
end

Players.PlayerAdded:Connect(function(target)
    if target ~= player then hookOtherPlayer(target) end
    task.defer(function()
        if refreshPlayerList then refreshPlayerList() end
        refreshPlayerVisuals()
    end)
end)

Players.PlayerRemoving:Connect(function(target)
    if selectedPlayer == target then
        selectedPlayer = nil
        if selectedPlayerLabel then selectedPlayerLabel.Text = "Selected player: none" end
        if spectating then refreshCameraSubject() end
    end
    task.defer(function()
        if refreshPlayerList then refreshPlayerList() end
        refreshPlayerVisuals()
    end)
end)

