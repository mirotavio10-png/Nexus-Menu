-- MOVEMENT HELPERS

local function stopFly()
    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if velocity then
        velocity:Destroy()
        velocity = nil
    end

    if gyro then
        gyro:Destroy()
        gyro = nil
    end

    if flyButton then
        flyButton.Text = "FLY  ·  OFF  [F]"
    end
end

local function toggleFly()
    if flying then
        stopFly()
        return
    end

    local character, root, humanoid = getCharacter()
    if not root or not humanoid or humanoid.Health <= 0 then return end

    flying = true
    flyButton.Text = "FLY  ·  ON  [F]"

    velocity = Instance.new("BodyVelocity")
    velocity.Name = "NexusFlyVelocity"
    velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    velocity.Velocity = Vector3.zero
    velocity.Parent = root

    gyro = Instance.new("BodyGyro")
    gyro.Name = "NexusFlyGyro"
    gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    gyro.P = 9000
    gyro.CFrame = root.CFrame
    gyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        if not root.Parent or not character.Parent then
            stopFly()
            return
        end

        local cf = camera.CFrame
        local move = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then move += cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end

        velocity.Velocity = move.Magnitude > 0 and move.Unit * flySpeed or Vector3.zero
        gyro.CFrame = CFrame.lookAt(root.Position, root.Position + cf.LookVector)
    end)
end

local function restoreCollisions()
    for part, original in pairs(oldCollisions) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(oldCollisions)
end

local function toggleNoclip()
    if noclip then
        noclip = false

        if clipConnection then
            clipConnection:Disconnect()
            clipConnection = nil
        end

        restoreCollisions()
        noclipButton.Text = "NOCLIP  ·  OFF  [N]"
        return
    end

    noclip = true
    noclipButton.Text = "NOCLIP  ·  ON  [N]"

    clipConnection = RunService.Stepped:Connect(function()
        local character = player.Character
        if not character then return end

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if oldCollisions[part] == nil then
                    oldCollisions[part] = part.CanCollide
                end

                part.CanCollide = false
            end
        end
    end)
end

local function resetMovement()
    stopFly()

    if noclip then
        noclip = false

        if clipConnection then
            clipConnection:Disconnect()
            clipConnection = nil
        end

        restoreCollisions()
    end

    noclipButton.Text = "NOCLIP  ·  OFF  [N]"

    walkSpeed = 16
    jumpPower = 50
    applyMovementStats()

    if walkSpeedLabel then walkSpeedLabel() end
    if jumpPowerLabel then jumpPowerLabel() end
end

