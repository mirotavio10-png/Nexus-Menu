local function getTargetHumanoid(target)
    local character = target and target.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function refreshCameraSubject()
    local camera = workspace.CurrentCamera
    local humanoid = getHumanoid()
    if camera and humanoid then
        camera.CameraSubject = humanoid
    end
    spectating = false
end

local function spectateSelected()
    -- P (or the UI button) is a true toggle: press once to watch,
    -- press again to return the camera to your own character.
    if spectating then
        refreshCameraSubject()
        notify("Spectator", "Returned to your character.")
        return
    end

    if not selectedPlayer then
        notify("Spectator", "Select a player first.")
        return
    end
    local targetHumanoid = getTargetHumanoid(selectedPlayer)
    if not targetHumanoid then
        notify("Spectator", "That player's character is not ready.")
        return
    end
    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraSubject = targetHumanoid
        spectating = true
        notify("Spectator", "Now watching " .. selectedPlayer.DisplayName .. ". Press P again to return.")
    end
end

local function teleportToSelected()
    if not selectedPlayer then
        notify("Teleport", "Select a player first.")
        return
    end
    local targetRoot = selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    local root = getRoot()
    if not targetRoot or not root then
        notify("Teleport", "A character is not ready.")
        return
    end
    root.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    notify("Teleport", "Moved near " .. selectedPlayer.DisplayName .. " locally.")
end

