        end
    end
    for _, nameLabel in ipairs(playerNameLabels) do
        if nameLabel and nameLabel.Parent then nameLabel.TextColor3 = COLORS.PurpleLight end
    end
    for indexNumber, entry in ipairs(accentSwatches) do
        if entry.stroke and entry.stroke.Parent then
