--========================================================
-- REMOTE SPY PAGE (SAFE CLIENT-SIDE DEBUG MONITOR)
-- Shows replicated remote inventory and incoming RemoteEvent traffic.
-- Standard LocalScripts cannot intercept other scripts' outgoing calls.
--========================================================
do
    local page = pages["Remote Spy"]
    page.CanvasSize = UDim2.fromOffset(0, 400)
    local MAX_LOGS = 60
    local monitoring = false
    local remoteInventory = {}
    local remoteEventConnections = {}
    local remoteLogs = {}
    local logSequence = 0
    local viewMode = "Inventory"
    local copyField

    local monitorButton
    local statusLabel
    local inventoryButton
    local incomingButton
    local setViewMode
    local logViewport
    local logLayout

    local function isRemote(instance)
        return instance:IsA("RemoteEvent")
            or instance:IsA("RemoteFunction")
            or instance.ClassName == "UnreliableRemoteEvent"
    end

    local function fullNameOf(instance)
        local ok, result = pcall(function()
            return instance:GetFullName()
        end)
        return ok and result or instance.Name
    end

    local function describeValue(value, depth, seen)
        local kind = typeof(value)
        if kind == "nil" then
            return "nil"
        elseif kind == "string" then
            local text = value:gsub("\n", "\\n")
            if #text > 90 then text = text:sub(1, 87) .. "..." end
            return string.format("%q", text)
        elseif kind == "Instance" then
            return "<" .. value.ClassName .. " " .. fullNameOf(value) .. ">"
        elseif kind == "Vector3" then
            return string.format("Vector3(%.1f, %.1f, %.1f)", value.X, value.Y, value.Z)
        elseif kind == "Vector2" then
            return string.format("Vector2(%.1f, %.1f)", value.X, value.Y)
        elseif kind == "CFrame" then
            local pos = value.Position
            return string.format("CFrame(%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z)
        elseif kind == "Color3" then
            return string.format("Color3(%d, %d, %d)",
                math.floor(value.R * 255 + 0.5),
                math.floor(value.G * 255 + 0.5),
                math.floor(value.B * 255 + 0.5))
        elseif kind == "table" then
            if depth >= 2 then return "{...}" end
            if seen[value] then return "{<cycle>}" end
            seen[value] = true
            local keys = {}
            for key in pairs(value) do
                table.insert(keys, key)
            end
            table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
            local parts = {}
            local shown = math.min(#keys, 5)
            for index = 1, shown do
                local key = keys[index]
                table.insert(parts, tostring(key) .. "=" .. describeValue(value[key], depth + 1, seen))
            end
            if #keys > shown then table.insert(parts, "...") end
            seen[value] = nil
            return "{" .. table.concat(parts, ", ") .. "}"
        else
            local result = tostring(value)
            if #result > 100 then result = result:sub(1, 97) .. "..." end
            return result
        end
    end

    local function formatArguments(arguments)
        local parts = {}
        for index = 1, arguments.n do
            table.insert(parts, describeValue(arguments[index], 0, {}))
        end
        return #parts > 0 and table.concat(parts, ", ") or "(no arguments)"
    end

    local function setCanvasToContent()
        if not logViewport or not logLayout then return end
        logViewport.CanvasSize = UDim2.fromOffset(0, logLayout.AbsoluteContentSize.Y + 8)
        logViewport.CanvasPosition = Vector2.new(0,
            math.max(0, logViewport.CanvasSize.Y.Offset - logViewport.AbsoluteSize.Y))
    end

    -- Clipboard access is not exposed to regular Roblox LocalScripts.
    -- The COPY button selects the text in this field so the user can press Ctrl+C.
    local function prepareCopy(text)
        if not copyField then return end
        copyField.Text = tostring(text or "")
        copyField:CaptureFocus()
        task.defer(function()
            if copyField and copyField.Parent then
                copyField.CursorPosition = #copyField.Text + 1
                copyField.SelectionStart = 1
            end
        end)
        notify("Remote Spy", "Text selected. Press Ctrl+C to copy.")
    end

    local function makeRow(text, order, height, copyText)
        local row = make("Frame", {
            Name = "RemoteSpyRow",
            BackgroundColor3 = COLORS.Item,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -8, 0, height),
            LayoutOrder = order,
