--==================================================
-- CHAMS / NAME TAG SYSTEM
--==================================================

local function clearPlayerVisuals(plr)
    if highlights[plr] then
        highlights[plr]:Destroy()
        highlights[plr] = nil
    end

    if nameTags[plr] then
        nameTags[plr]:Destroy()
        nameTags[plr] = nil
    end
end

local function updatePlayerVisuals(plr)
    if plr == LocalPlayer then
        clearPlayerVisuals(plr)
        return
    end

    local character = plr.Character

    if not character then
        clearPlayerVisuals(plr)
        return
    end

    -- Highlight
    if chamsEnabled then
        local h = highlights[plr]

        if not h or h.Parent ~= character then
            if h then h:Destroy() end

            h = Instance.new("Highlight")
            h.Name = "NexusHighlight"
            h.Adornee = character
            h.FillColor = C.Accent
            h.OutlineColor = Color3.new(1, 1, 1)
            h.FillTransparency = 0.55
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = character

            highlights[plr] = h
        end
    elseif highlights[plr] then
        highlights[plr]:Destroy()
        highlights[plr] = nil
    end

    -- Name tag
    if namesEnabled then
        local head = character:FindFirstChild("Head")
        if not head then return end

        local tag = nameTags[plr]

        if not tag or tag.Parent ~= head then
            if tag then tag:Destroy() end

            tag = Instance.new("BillboardGui")
            tag.Name = "NexusNameTag"
            tag.Adornee = head
            tag.Size = UDim2.fromOffset(180, 36)
            tag.StudsOffset = Vector3.new(0, 2.7, 0)
            tag.AlwaysOnTop = true
            tag.MaxDistance = 100000
            tag.LightInfluence = 0
            tag.Parent = head

            local backing = Instance.new("Frame")
            backing.Size = UDim2.fromScale(1, 1)
            backing.BackgroundColor3 = C.Background
            backing.BackgroundTransparency = 0.15
            backing.BorderSizePixel = 0
            backing.Parent = tag
            round(backing, 7)
            stroke(backing, C.Accent, 0.2, 1)

            local name = Instance.new("TextLabel")
            name.BackgroundTransparency = 1
            name.Position = UDim2.fromOffset(5, 0)
            name.Size = UDim2.new(1, -10, 1, 0)
            name.Font = Enum.Font.GothamBold
            name.Text = plr.DisplayName .. "  @" .. plr.Name
            name.TextColor3 = C.Text
            name.TextSize = 11
            name.TextStrokeTransparency = 0.65
            name.TextScaled = false
            name.Parent = backing

            nameTags[plr] = tag
        end
    elseif nameTags[plr] then
        nameTags[plr]:Destroy()
        nameTags[plr] = nil
    end
end

