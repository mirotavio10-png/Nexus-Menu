-- KEYBOARD HANDLER
UIS.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	-- Capture the next key chosen in Controls.
	if waitingForKey then
		local actionName = waitingForKey
		waitingForKey = nil

		if input.KeyCode == Enum.KeyCode.Escape then
			if keybindStatus then
				keybindStatus.Text = "Keybind change cancelled."
			end
			return
		end

		if input.KeyCode == Enum.KeyCode.Unknown then
			return
		end

		if actionName == "Menu Toggle" then
			menuKey = input.KeyCode
		elseif actionName == "Fly" then
			flyKey = input.KeyCode
		elseif actionName == "Noclip" then
			noclipKey = input.KeyCode
		end

		updateKeybindButtons()

		if keybindStatus then
			keybindStatus.Text = actionName .. " set to " .. input.KeyCode.Name
		end

		notify("Keybind updated", actionName .. ": " .. input.KeyCode.Name)
		return
	end

	if gameProcessed then return end

	if input.KeyCode == menuKey then
		main.Visible = not main.Visible
		return
	end

	if input.KeyCode == flyKey then
		toggleFly()
	elseif input.KeyCode == noclipKey then
		setNoclip(not noclipEnabled)
	end
end)

