refreshPlayerVisuals = function()
    clearPlayerVisuals()
    -- Selection highlight is independent of the general chams toggle,
    -- so the currently selected player remains clearly marked in white.
    if not chamsEnabled and not teamChamsEnabled and not nameTagsEnabled and not selectedPlayer then return end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            local character = target.Character
            local root = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local isSelected = target == selectedPlayer

            if (chamsEnabled or teamChamsEnabled or isSelected) and humanoid then
                local highlight = Instance.new("Highlight")
                highlight.Name = isSelected and "NEXU_SelectedPlayerHighlight" or "NEXU_LocalHighlight"
                highlight:SetAttribute("NEXU_SelectedPlayer", isSelected)
                highlight.Adornee = character

                -- Selected players stay white. Team Chams uses the Roblox TeamColor
                -- for each player's team, with the menu accent as a fallback.
                local fillColor = COLORS.Purple
                local outlineColor = COLORS.PurpleLight
                if teamChamsEnabled and target.Team then
                    fillColor = target.Team.TeamColor.Color
                    outlineColor = fillColor:Lerp(Color3.new(1, 1, 1), 0.3)
                end
                if isSelected then
                    fillColor = Color3.new(1, 1, 1)
                    outlineColor = Color3.new(1, 1, 1)
                end

                highlight.FillColor = fillColor
                highlight.OutlineColor = outlineColor
                highlight.FillTransparency = isSelected and 0.55 or 0.78
                highlight.OutlineTransparency = isSelected and 0 or 0.08
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = character
                table.insert(playerHighlights, highlight)
            end

            if nameTagsEnabled and root then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "NEXU_LocalNameTag"
                billboard.Adornee = root
                billboard.Size = UDim2.fromOffset(190, 30)
                billboard.StudsOffset = Vector3.new(0, 2.8, 0)
