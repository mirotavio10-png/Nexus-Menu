-- FLY
local toggleFly

local function stopFly()
	flyEnabled = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end

	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end

	local hum = myHumanoid()
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function startFly()
	local root = myRoot()
	local hum = myHumanoid()

	if not root or not hum then
		notify("Fly", "Character is not ready.")
		return
	end

	stopFly()
	flyEnabled = true

	flyVelocity = make("BodyVelocity", {
		MaxForce = Vector3.new(1e6, 1e6, 1e6),
		Velocity = Vector3.zero,
		P = 12500,
	}, root)

	flyGyro = make("BodyGyro", {
		MaxTorque = Vector3.new(1e6, 1e6, 1e6),
		P = 10000,
		D = 500,
		CFrame = workspace.CurrentCamera.CFrame,
	}, root)

	hum.PlatformStand = true

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flyEnabled or not root.Parent then
			stopFly()
			return
		end

		local camera = workspace.CurrentCamera
		local direction = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.new(0, 1, 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.new(0, 1, 0)
		end

		flyVelocity.Velocity =
			direction.Magnitude > 0 and direction.Unit * flySpeed
			or Vector3.zero

		flyGyro.CFrame = camera.CFrame
	end)

	notify("Fly", "Enabled: WASD, Space and Left Ctrl.")
end

toggleFly = function()
	if flyEnabled then
		stopFly()
		notify("Fly", "Disabled.")
	else
		startFly()
	end
end

-- NOCLIP
local function setNoclip(value)
	noclipEnabled = value

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if value then
		noclipConnection = RunService.Stepped:Connect(function()
			local character = player.Character
			if not character then return end

			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					if originalCollisions[part] == nil then
						originalCollisions[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		end)

		notify("Noclip", "Enabled.")
	else
		for part, oldValue in pairs(originalCollisions) do
			if part and part.Parent then
				part.CanCollide = oldValue
			end
		end

		table.clear(originalCollisions)
		notify("Noclip", "Disabled.")
	end
end

