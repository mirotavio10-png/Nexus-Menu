        addCorner(row, 6)
        local hasCopy = copyText ~= nil
        local rowText = addLabel(row, text, UDim2.fromOffset(8, 4),
            UDim2.new(1, hasCopy and -72 or -16, 1, -8), 9, COLORS.Text, Enum.Font.Code)
        rowText.TextYAlignment = Enum.TextYAlignment.Top

        if hasCopy then
            addButton(row, "COPY", UDim2.new(1, -62, 0.5, -11),
                UDim2.fromOffset(54, 22), function()
                    prepareCopy(copyText)
                end, COLORS.Purple)
        end
        return row
    end

    local function clearRows()
        if not logViewport then return end
        for _, child in ipairs(logViewport:GetChildren()) do
            if child:IsA("Frame") and child.Name == "RemoteSpyRow" then
                child:Destroy()
            end
        end
    end

    local function renderCurrentView()
        if not logViewport then return end
        clearRows()

        if viewMode == "Inventory" then
            for index, remote in ipairs(remoteInventory) do
                makeRow(remote.ClassName .. "  |  " .. fullNameOf(remote), index, 32,
                    fullNameOf(remote))
            end
            if #remoteInventory == 0 then
                makeRow("No RemoteEvents or RemoteFunctions found in ReplicatedStorage.", 1, 42)
            end
        else
            for index, entry in ipairs(remoteLogs) do
                makeRow(entry.text, entry.sequence, 58, entry.text)
            end
            if #remoteLogs == 0 then
                makeRow("No incoming RemoteEvent traffic logged yet. Start monitoring, then trigger an event from the server.", 1, 52)
            end
        end
        task.defer(setCanvasToContent)
    end

    local function updateStatus()
        local eventCount, functionCount, unreliableCount = 0, 0, 0
        for _, remote in ipairs(remoteInventory) do
            if remote.ClassName == "UnreliableRemoteEvent" then
                unreliableCount += 1
            elseif remote:IsA("RemoteEvent") then
                eventCount += 1
            elseif remote:IsA("RemoteFunction") then
                functionCount += 1
            end
        end
        if statusLabel then
            statusLabel.Text = string.format("Monitor: %s  |  Events: %d  |  Unreliable: %d  |  Functions: %d",
                monitoring and "ON" or "OFF", eventCount, unreliableCount, functionCount)
        end
    end

    local function collectInventory()
        table.clear(remoteInventory)
        for _, instance in ipairs(ReplicatedStorage:GetDescendants()) do
            if isRemote(instance) then
                table.insert(remoteInventory, instance)
            end
        end
        table.sort(remoteInventory, function(a, b)
            return fullNameOf(a) < fullNameOf(b)
        end)
        updateStatus()
        if viewMode == "Inventory" then renderCurrentView() end
    end

    local function addIncomingLog(remote, arguments)
        logSequence += 1
        local message = string.format("#%d  INCOMING  %s\nArgs: %s",
            logSequence, fullNameOf(remote), formatArguments(arguments))
        table.insert(remoteLogs, { sequence = logSequence, text = message })
        local exceededLimit = #remoteLogs > MAX_LOGS
        if exceededLimit then table.remove(remoteLogs, 1) end

        if viewMode == "Incoming Log" and logViewport then
            if exceededLimit then
                local oldestRow
                for _, child in ipairs(logViewport:GetChildren()) do
                    if child:IsA("Frame") and child.Name == "RemoteSpyRow"
                        and (not oldestRow or child.LayoutOrder < oldestRow.LayoutOrder) then
                        oldestRow = child
                    end
                end
                if oldestRow then oldestRow:Destroy() end
            end
            makeRow(message, logSequence, 58, message)
            task.defer(setCanvasToContent)
        end
    end

    local function attachRemote(remote)
        if not monitoring or remoteEventConnections[remote] then return end
        if remote:IsA("RemoteEvent") or remote.ClassName == "UnreliableRemoteEvent" then
            remoteEventConnections[remote] = remote.OnClientEvent:Connect(function(...)
                addIncomingLog(remote, table.pack(...))
            end)
        end
    end

    local function setMonitoring(value)
        monitoring = value == true
        if monitoring then
            for _, remote in ipairs(remoteInventory) do
                attachRemote(remote)
            end
            if monitorButton then monitorButton.Text = "Stop Monitoring" end
        else
            for remote, connection in pairs(remoteEventConnections) do
                connection:Disconnect()
                remoteEventConnections[remote] = nil
            end
            if monitorButton then monitorButton.Text = "Start Monitoring" end
        end
        updateStatus()
    end

