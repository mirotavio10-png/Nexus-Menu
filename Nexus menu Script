-- Cycle to the next player alphabetically, wrap at the end, and select only.
-- Spectating remains a separate action on the P key / Toggle Spectating button.
spectateNextPlayer = function()
    local candidates = {}
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            table.insert(candidates, target)
        end
    end

    table.sort(candidates, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    if #candidates == 0 then
        notify("Spectator", "No other players are in this server.")
        return
    end

    local currentIndex = 0
    for index, target in ipairs(candidates) do
        if target == selectedPlayer then
            currentIndex = index
            break
        end
    end

    local nextIndex = (currentIndex % #candidates) + 1
    selectedPlayer = candidates[nextIndex]
    if selectedPlayerLabel then
        selectedPlayerLabel.Text = "Selected player: " .. selectedPlayer.DisplayName .. "  @" .. selectedPlayer.Name
    end
    if refreshPlayerList then
        refreshPlayerList()
    end

    notify("Player selected", selectedPlayer.DisplayName .. " selected. Press " .. keybinds["Spectate Selected"].Name .. " to spectate.")
end

