    tpButton.TextColor3 = C.Text
    tpButton.TextSize = 9
    tpButton.Font = Enum.Font.GothamBold
    tpButton.BorderSizePixel = 0
    tpButton.Parent = card

    Instance.new("UICorner", tpButton).CornerRadius = UDim.new(0, 7)

    local resetButton = Instance.new("TextButton")
    resetButton.Position = UDim2.new(0.67, 0, 0, 59)
    resetButton.Size = UDim2.new(0.33, -10, 0, 30)
    resetButton.BackgroundColor3 = Color3.fromRGB(83, 38, 51)
    resetButton.Text = "RESET"
    resetButton.TextColor3 = C.Text
    resetButton.TextSize = 9
    resetButton.Font = Enum.Font.GothamBold
    resetButton.BorderSizePixel = 0
    resetButton.Parent = card

    Instance.new("UICorner", resetButton).CornerRadius = UDim.new(0, 7)

    saveButton.Activated:Connect(function()
        local _, root = getCharacter()
        if not root then return end

        savedPoints[i] = root.CFrame

        status.Text = string.format(
            "Saved: %.0f, %.0f, %.0f",
            root.Position.X,
            root.Position.Y,
            root.Position.Z
        )

        status.TextColor3 = C.Green
        saveButton.Text = "UPDATE"
    end)

    tpButton.Activated:Connect(function()
        local character = player.Character

        if not savedPoints[i] or not character then
            status.Text = "Save a position first!"
            status.TextColor3 = C.Red
            return
        end

        character:PivotTo(savedPoints[i])
    end)

    resetButton.Activated:Connect(function()
        savedPoints[i] = nil
        status.Text = "Empty"
        status.TextColor3 = C.Muted
        saveButton.Text = "SAVE"
    end)
end

