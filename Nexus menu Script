local function makeToggle(parent, title, y, initialValue, callback)
    local row = make("Frame", {
        BackgroundColor3 = COLORS.Item,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, y),
        Size = UDim2.new(1, -24, 0, 37),
    }, parent)
    addCorner(row, 8)
    addLabel(row, title, UDim2.fromOffset(10, 0),
        UDim2.new(1, -88, 1, 0), 11, COLORS.Text, Enum.Font.GothamMedium)

    local toggleButton = addButton(row, "OFF", UDim2.new(1, -68, 0.5, -12),
        UDim2.fromOffset(56, 24), nil, COLORS.Panel)
    local control = { value = initialValue }
    -- addButton supplies hover colors; restore the true ON/OFF color on mouse leave.
    toggleButton.MouseLeave:Connect(function()
        toggleButton.BackgroundColor3 = control.value and COLORS.Purple or COLORS.Panel
    end)

    local function setValue(value, silent)
        control.value = value == true
        toggleButton.Text = control.value and "ON" or "OFF"
        local resting = control.value and COLORS.Purple or COLORS.Panel
        toggleButton:SetAttribute("NEXU_RestingColor", resting)
        toggleButton.BackgroundColor3 = resting
        if callback then callback(control.value, silent == true) end
    end
    control.setValue = setValue
    control.button = toggleButton
    toggleButton.Activated:Connect(function()
        setValue(not control.value, false)
    end)
    setValue(initialValue, true)
    table.insert(toggleControls, control)
    return control
end

--========================================================
-- MOVEMENT / FLIGHT / NOCLIP
--========================================================
local function applyMovement()
    local humanoid = getHumanoid()
    if not humanoid then return end
    humanoid.WalkSpeed = runEnabled and runSpeedValue or walkSpeedValue
    humanoid.UseJumpPower = true
    humanoid.JumpPower = jumpPowerValue
end

local function cleanFlightObjects()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyOrientation then flyOrientation:Destroy(); flyOrientation = nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end
end

local function stopFly()
    cleanFlightObjects()
    local humanoid = getHumanoid()
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
end

local function startFly()
    cleanFlightObjects()
    local character = getCharacter()
    local root = getRoot()
    local humanoid = getHumanoid()
    if not character or not root or not humanoid then
        notify("Fly", "Character is not ready.")
        return
    end

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "NEXU_FlyAttachment"
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "NEXU_FlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.MaxForce = 1000000
    flyVelocity.Parent = root

    flyOrientation = Instance.new("AlignOrientation")
    flyOrientation.Name = "NEXU_FlyOrientation"
    flyOrientation.Attachment0 = flyAttachment
    flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyOrientation.MaxTorque = 1000000
    flyOrientation.Responsiveness = 12
    flyOrientation.Parent = root

    humanoid.AutoRotate = false
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyEnabled or not root.Parent or player.Character ~= character then
            cleanFlightObjects()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end
        local direction = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.new(0, 1, 0) end

        flyVelocity.VectorVelocity = direction.Magnitude > 0 and direction.Unit * flySpeedValue or Vector3.zero
        flyOrientation.CFrame = camera.CFrame.Rotation
    end)
end

local function setNoclip(value)
    noclipEnabled = value == true
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if not noclipEnabled then
        for part, oldValue in pairs(originalCollisions) do
            if part and part.Parent then part.CanCollide = oldValue end
        end
        table.clear(originalCollisions)
        return
    end

    noclipConnection = RunService.Stepped:Connect(function()
        local character = getCharacter()
        if not character then return end
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                if originalCollisions[object] == nil then
                    originalCollisions[object] = object.CanCollide
                end
                object.CanCollide = false
            end
        end
    end)
end

