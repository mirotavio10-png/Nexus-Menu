-- TAB SWITCHING

local function switchTab(tab)
    playerPage.Visible = tab == "Player"
    spectatorPage.Visible = tab == "Spectator"
    worldPage.Visible = tab == "World"

    playerTab.BackgroundColor3 = tab == "Player" and C.Accent or C.Panel
    playerTab.TextColor3 = tab == "Player" and C.Text or C.Muted

    spectatorTab.BackgroundColor3 = tab == "Spectator" and C.Accent or C.Panel
    spectatorTab.TextColor3 = tab == "Spectator" and C.Text or C.Muted

    worldTab.BackgroundColor3 = tab == "World" and C.Accent or C.Panel
    worldTab.TextColor3 = tab == "World" and C.Text or C.Muted
end

playerTab.Activated:Connect(function()
    switchTab("Player")
end)

spectatorTab.Activated:Connect(function()
    switchTab("Spectator")
end)

worldTab.Activated:Connect(function()
    switchTab("World")
end)

-- HIDE / SHOW GUI

local function toggleGui()
    gui.Enabled = not gui.Enabled
end

hideButton.Activated:Connect(toggleGui)

-- KEYBOARD SHORTCUTS

UIS.InputBegan:Connect(function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end

    if input.KeyCode == Enum.KeyCode.LeftAlt then
        toggleGui()
    elseif input.KeyCode == Enum.KeyCode.F then
        toggleFly()
    elseif input.KeyCode == Enum.KeyCode.N then
        toggleNoclip()
    end
end)

-- PLAYER EVENTS

Players.PlayerAdded:Connect(refreshPlayers)

Players.PlayerRemoving:Connect(function(leaving)
    if selectedPlayer == leaving then
        selectedPlayer = nil
        selectedLabel.Text = "  No player selected"

        if spectating then
            stopSpectating()
        end
    end

    refreshPlayers()
end)

-- RESPAWN CLEANUP

player.CharacterAdded:Connect(function(character)
    stopFly()

    if noclip then
        noclip = false

        if clipConnection then
            clipConnection:Disconnect()
            clipConnection = nil
        end

        restoreCollisions()
    end

    noclipButton.Text = "NOCLIP  ·  OFF  [N]"

    if spectating then
        spectating = false
        spectateButton.Text = "START SPECTATING"
    end

    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.WalkSpeed = walkSpeed
        humanoid.JumpPower = jumpPower
    end
end)

-- INITIALIZE

refreshPlayers()
switchTab("Player")
applyMovementStats()
