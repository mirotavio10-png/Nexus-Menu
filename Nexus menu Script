local function refreshTheme()
	C.Purple = accentColors[accentIndex]
	C.PurpleLight = C.Purple:Lerp(Color3.new(1, 1, 1), 0.28)

	mainStroke.Color = C.Purple
	logo.BackgroundColor3 = C.Purple
	logoStroke.Color = C.PurpleLight

	for _, entry in ipairs(themeButtons) do
		local obj = entry.object

		if obj and obj.Parent then
			if entry.role == "selectedTab" then
				obj.BackgroundColor3 = C.Purple
			elseif entry.role == "tab" then
				obj.BackgroundColor3 = entry.baseColor
			elseif entry.role == "accentButton" then
				obj.BackgroundColor3 = C.Purple
			end
		end
	end

	for _, entry in ipairs(themeLabels) do
		local obj = entry.object

		if obj and obj.Parent then
			if entry.role == "accent" then
				obj.TextColor3 = C.Purple
			elseif entry.role == "accentLight" then
				obj.TextColor3 = C.PurpleLight
			end
		end
	end

	for _, obj in ipairs(themeStrokes) do
		if obj and obj.Parent then
			obj.Color = C.Purple
		end
	end

	for _, item in ipairs(highlights) do
		if item and item.Parent then
			item.FillColor = C.Purple
			item.OutlineColor = C.PurpleLight
		end
	end

	for _, tag in ipairs(nameTags) do
		local text = tag:FindFirstChildWhichIsA("TextLabel")
		if text then
			text.TextColor3 = C.PurpleLight
		end
	end

	for _, page in pairs(pages) do
		page.ScrollBarImageColor3 = C.Purple
	end

	notify("Theme", accentNames[accentIndex] .. " applied.")
end

