-- THEME REGISTRIES
local themeButtons = {}
local themeLabels = {}
local themeStrokes = {}

local function registerButton(obj, baseColor, role)
	table.insert(themeButtons, {
		object = obj,
		baseColor = baseColor,
		role = role or "normal",
	})
end

local function registerLabel(obj, role)
	table.insert(themeLabels, {
		object = obj,
		role = role or "normal",
	})
end

local function registerStroke(obj)
	table.insert(themeStrokes, obj)
end

-- INSTANCE HELPERS
local function make(className, props, parent)
	local obj = Instance.new(className)

	for property, value in pairs(props or {}) do
		obj[property] = value
	end

	obj.Parent = parent
	return obj
end

local function corner(obj, radius)
	make("UICorner", {
		CornerRadius = UDim.new(0, radius or 8),
	}, obj)
end

local function stroke(obj, color, thickness)
	local s = make("UIStroke", {
		Color = color or C.Purple,
		Thickness = thickness or 1,
		Transparency = 0.12,
	}, obj)

	registerStroke(s)
	return s
end

local function label(parent, text, position, size, textSize, color, role)
	local obj = make("TextLabel", {
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Text = text,
		TextColor3 = color or C.Text,
		Font = Enum.Font.Gotham,
		TextSize = textSize or 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
	}, parent)

	registerLabel(obj, role or "normal")
	return obj
end

local function button(parent, text, position, size, callback, baseColor, role)
	baseColor = baseColor or C.Item

	local obj = make("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = baseColor,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		AutoButtonColor = false,
	}, parent)

	corner(obj, 7)
	registerButton(obj, baseColor, role or "normal")

	obj.MouseEnter:Connect(function()
		if obj.Parent then
			TweenService:Create(obj, TweenInfo.new(0.12), {
				BackgroundColor3 = C.Purple,
				TextColor3 = Color3.new(1, 1, 1),
			}):Play()
		end
	end)

	obj.MouseLeave:Connect(function()
		if obj.Parent then
			TweenService:Create(obj, TweenInfo.new(0.12), {
				BackgroundColor3 = baseColor,
				TextColor3 = C.Text,
			}):Play()
		end
	end)

	obj.Activated:Connect(function()
		if callback then callback() end
	end)

	return obj
end

