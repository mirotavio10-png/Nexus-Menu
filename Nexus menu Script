-- WORLD VISUALS
local function clearHighlights()
	for _, obj in ipairs(highlights) do
		if obj and obj.Parent then obj:Destroy() end
	end
	table.clear(highlights)
end

local function clearTags()
	for _, obj in ipairs(nameTags) do
		if obj and obj.Parent then obj:Destroy() end
	end
	table.clear(nameTags)
end

local function applyHighlights()
	clearHighlights()
	if not chamsEnabled then return end

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			local h = make("Highlight", {
				Name = "NEXU_Highlight",
				Adornee = target.Character,
				FillColor = C.Purple,
				OutlineColor = C.PurpleLight,
				FillTransparency = 0.55,
				OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, target.Character)

			table.insert(highlights, h)
		end
	end
end

local function applyTags()
	clearTags()
	if not tagsEnabled then return end

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			local root = rootOf(target)

			if root then
				local tag = make("BillboardGui", {
					Name = "NEXU_NameTag",
					Adornee = root,
					Size = UDim2.fromOffset(200, 35),
					StudsOffset = Vector3.new(0, 3, 0),
					AlwaysOnTop = true,
					MaxDistance = 100000,
				}, root)

				local text = make("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
					Text = target.DisplayName .. "  @" .. target.Name,
					TextColor3 = C.PurpleLight,
					TextStrokeTransparency = 0.35,
					TextStrokeColor3 = Color3.new(0, 0, 0),
					Font = Enum.Font.GothamBold,
					TextSize = 12,
				}, tag)

				table.insert(nameTags, tag)
			end
		end
	end
end

local function makeToggle(parent, text, y, initial, callback)
	local row = make("Frame", {
		BackgroundColor3 = C.Item,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, y),
		Size = UDim2.new(1, -20, 0, 35),
	}, parent)
	corner(row, 7)

	label(
		row, text,
		UDim2.fromOffset(10, 0),
		UDim2.new(1, -80, 1, 0), 11
	)

	local active = initial

	local toggleButton = button(
		row,
		active and "ON" or "OFF",
		UDim2.new(1, -62, 0.5, -12),
		UDim2.fromOffset(52, 24),
		nil,
		active and C.Purple or C.Panel
	)

	local function setValue(value)
		active = value
		toggleButton.Text = active and "ON" or "OFF"
		toggleButton.BackgroundColor3 = active and C.Purple or C.Panel
		callback(active)
	end

	toggleButton.Activated:Connect(function()
		setValue(not active)
	end)

	return setValue
end

