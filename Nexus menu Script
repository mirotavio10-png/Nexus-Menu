--========================================================
-- DRAGGABLE SLIDER WIDGET
--========================================================
local function makeSlider(parent, title, y, minimum, maximum, initialValue, callback)
    local row = make("Frame", {
        BackgroundColor3 = COLORS.Item,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, y),
        Size = UDim2.new(1, -24, 0, 63),
    }, parent)
    addCorner(row, 8)

    local titleLabel = addLabel(row, title, UDim2.fromOffset(10, 4),
        UDim2.new(1, -100, 0, 22), 11, COLORS.Text, Enum.Font.GothamMedium)
    local valueLabel = addLabel(row, tostring(initialValue), UDim2.new(1, -82, 0, 4),
        UDim2.fromOffset(70, 22), 11, COLORS.PurpleLight, Enum.Font.GothamBold)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = make("Frame", {
        Name = "Track",
        Active = true,
        BackgroundColor3 = Color3.fromRGB(61, 49, 81),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 11, 0, 39),
        Size = UDim2.new(1, -22, 0, 7),
    }, row)
    addCorner(track, 4)

    local fill = make("Frame", {
        Name = "Fill",
        Active = true,
        BackgroundColor3 = COLORS.Purple,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    }, track)
    addCorner(fill, 4)

    local knob = make("Frame", {
        Name = "Knob",
        Active = true,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = COLORS.Text,
        BorderSizePixel = 0,
    }, track)
    addCorner(knob, 7)
    addStroke(knob, COLORS.Purple, 1.5)

    local control = { value = initialValue, minimum = minimum, maximum = maximum }
    local function setValue(value, silent)
        value = math.clamp(math.floor(value + 0.5), minimum, maximum)
        control.value = value
        local alpha = (value - minimum) / (maximum - minimum)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        if callback and not silent then callback(value) end
    end
    control.setValue = setValue
    control.row = row
    control.fill = fill
    control.knob = knob
    control.knobStroke = knob:FindFirstChildOfClass("UIStroke")

    local function updateFromX(screenX)
        if track.AbsoluteSize.X <= 0 then return end
        local alpha = math.clamp((screenX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        setValue(minimum + (maximum - minimum) * alpha)
    end
    control.updateFromX = updateFromX

    local function startDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = control
            updateFromX(input.Position.X)
        end
    end
    track.InputBegan:Connect(startDrag)
    fill.InputBegan:Connect(startDrag)
    knob.InputBegan:Connect(startDrag)

    setValue(initialValue, true)
    table.insert(sliderControls, control)
    return control
end

UserInputService.InputChanged:Connect(function(input)
    if activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        activeSlider.updateFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        activeSlider = nil
    end
end)

