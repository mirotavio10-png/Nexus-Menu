local function create(className, props, parent)
    local object = Instance.new(className)

    for property, value in pairs(props or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, object)
end

local function stroke(object, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or C.Accent,
        Transparency = transparency or 0.5,
        Thickness = thickness or 1
    }, object)
end

local function makeLabel(parent, text, position, size, textSize, color)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Position = position,
        Size = size,
        Text = text,
        TextColor3 = color or C.Text,
        TextSize = textSize or 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    }, parent)
end

local function makeButton(parent, text, position, size, callback)
    local button = create("TextButton", {
        Position = position,
        Size = size,
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.Text,
        TextSize = 11,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false
    }, parent)

    round(button, 7)

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = C.Hover
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = C.Element
    end)

    button.Activated:Connect(function()
        if callback then
            callback()
        end
    end)

    return button
end

local function makeSection(parent, text, y)
    local label = makeLabel(
        parent,
        text,
        UDim2.fromOffset(10, y),
        UDim2.new(1, -20, 0, 21),
        11,
        C.AccentLight
    )

    label.Font = Enum.Font.GothamBold
    return label
end

local function makeToggle(parent, text, y, callback)
    local button = create("TextButton", {
        Position = UDim2.fromOffset(10, y),
        Size = UDim2.new(1, -20, 0, 32),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, parent)

    round(button, 7)

    local title = makeLabel(
        button,
        text,
        UDim2.fromOffset(10, 0),
        UDim2.new(1, -85, 1, 0),
        11
    )

    local stateLabel = create("TextLabel", {
        Position = UDim2.new(1, -65, 0, 5),
        Size = UDim2.fromOffset(54, 22),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        Text = "OFF",
        TextColor3 = C.Muted,
        TextSize = 10,
        Font = Enum.Font.GothamBold
    }, button)

    round(stateLabel, 6)

    local state = false

    local function setState(value)
        state = value
        stateLabel.Text = state and "ON" or "OFF"
        stateLabel.TextColor3 = state and C.Green or C.Muted
        stateLabel.BackgroundColor3 = state
            and Color3.fromRGB(24, 56, 43)
            or C.Background

        callback(state)
    end

    button.Activated:Connect(function()
        setState(not state)
    end)

    return function()
        return state
    end, setState
end

